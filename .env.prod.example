# Production. Copy to `.env.prod`. Do not put real secrets in this file.

DJANGO_SETTINGS_MODULE=claro_rf_check.settings.production
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

POSTGRES_DB=claro_rf_check
POSTGRES_USER=claro_rf_check
POSTGRES_PASSWORD=
DB_HOST=
DB_PORT=5432

CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
EP_IMPORT_RETENTION_DAYS=15

USE_OBS_MEDIA=True
OBS_BUCKET_NAME=
OBS_ENDPOINT=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_PUBLIC_ENDPOINT=
OBS_ADDRESSING_STYLE=virtual
OBS_URL_PROTOCOL=https:

# --- Core Connect SSO ---
CORE_CONNECT_SSO_ENVIRONMENT=production
CORE_CONNECT_SSO_ISSUER=
CORE_CONNECT_SSO_INTERNAL_ISSUER=
CORE_CONNECT_SSO_CLIENT_ID=claro-rf
CORE_CONNECT_SSO_REDIRECT_URI=
CORE_CONNECT_SSO_SCOPES=openid profile email
CORE_CONNECT_SSO_ALLOW_INSECURE_TRANSPORT=false
CORE_CONNECT_SSO_LOGIN_REDIRECT_URL=/
CORE_CONNECT_SSO_LOGOUT_REDIRECT_URL=/claro-rf/sso/login/
CORE_CONNECT_SSO_PROJECT_ID=84791364
GITLAB_PYPI_USER=
