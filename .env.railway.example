# Railway test environment. Set real secrets only in the service Variables page.

DJANGO_SETTINGS_MODULE=claro_rf_check.settings.railway
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=<generated-domain>.up.railway.app
CSRF_TRUSTED_ORIGINS=https://<generated-domain>.up.railway.app

# Reference these from the Railway Postgres service (private network, no public proxy).
POSTGRES_DB=${{Postgres.PGDATABASE}}
POSTGRES_USER=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}

# Attach one Volume to this service at /data. Keep a single web replica.
MEDIA_ROOT=/data/media
USE_OBS_MEDIA=False

# Build-time only. Railway passes this to the Dockerfile ARG. Do not print it.
# Use a GitLab token that can read the core-connect-sso package registry (project 84791364).
GITLAB_PYPI_TOKEN=
CORE_CONNECT_SSO_PROJECT_ID=84791364
GITLAB_PYPI_USER=gitlab-ci-token

# HTTP Basic authentication in front of the public URL. Health check /healthz stays open.
CLARO_RF_TEST_AUTH_ENABLED=true
CLARO_RF_TEST_AUTH_USERNAME=
CLARO_RF_TEST_AUTH_PASSWORD=

# Local Django user created by `ensure_test_user` during pre-deploy.
# Sign in at /accounts/login/ after the browser Basic prompt.
CLARO_RF_TEST_USERNAME=
CLARO_RF_TEST_PASSWORD=
CLARO_RF_TEST_EMAIL=
