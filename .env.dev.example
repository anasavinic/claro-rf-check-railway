# Claro RF Check env template. Local file: copy to `.env.dev`, then `cp .env.dev .env`.
# If a value contains $, escape it as $$ (Docker Compose interpolation).

# --- Django ---
# Local: claro_rf_check.settings.dev | Staging: settings.staging | Prod: settings.production
DJANGO_SETTINGS_MODULE=claro_rf_check.settings.dev
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Alias used by SSO secure settings (defaults to ALLOWED_HOSTS when unset).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DB=claro_rf_check
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=admin

# --- Email (Mailpit in local Docker) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=claro-rf-check@localhost

# --- Redis / Celery ---
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
EP_IMPORT_RETENTION_DAYS=15

# --- Object storage (MinIO local / OBS cloud) ---
USE_OBS_MEDIA=True
OBS_BUCKET_NAME=claro-rf-check
OBS_ENDPOINT=http://minio:9000
# path-style required for MinIO Docker DNS (virtual → claro-rf-check.minio fails).
OBS_ADDRESSING_STYLE=path
OBS_CUSTOM_DOMAIN=localhost:9120/claro-rf-check
# OBS_PUBLIC_ENDPOINT=http://localhost:9120
OBS_ACCESS_KEY=minioadmin
OBS_SECRET_KEY=minioadmin
# OBS_URL_PROTOCOL=http:
# OBS_URL_EXPIRE_SECONDS=3600

# --- Debug (leave empty to disable; do not set False) ---
DEBUG_PYCHARM=
DEBUG_VSCODE=
DEBUG_CELERY=

# --- Private PyPI (core-connect-sso Package Registry) ---
# Export GITLAB_PYPI_TOKEN in the shell for Docker build (or set below locally only).
# Do not commit the token. For a personal access token use __token__ or your GitLab username.
# Docker `dev` installs dev-requirements.txt — keep core-connect-sso pinned there too.
CORE_CONNECT_SSO_PROJECT_ID=84791364
GITLAB_PYPI_USER=__token__

# --- Core Connect SSO (browser login) ---
CORE_CONNECT_SSO_ISSUER=http://localhost:8001
CORE_CONNECT_SSO_INTERNAL_ISSUER=http://host.docker.internal:8001
CORE_CONNECT_SSO_CLIENT_ID=claro-rf
CORE_CONNECT_SSO_REDIRECT_URI=http://localhost:8007/claro-rf/sso/callback/
CORE_CONNECT_SSO_SCOPES=openid profile email
CORE_CONNECT_SSO_ALLOW_INSECURE_TRANSPORT=true
CORE_CONNECT_SSO_ENVIRONMENT=development
CORE_CONNECT_SSO_LOGIN_REDIRECT_URL=/
CORE_CONNECT_SSO_LOGOUT_REDIRECT_URL=/claro-rf/sso/login/
# Optional: mock SSO without IdP (CI / offline)
# CORE_CONNECT_SSO_DEV=1
